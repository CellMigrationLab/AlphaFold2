{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "AlphaFold2",
  "menu_items": [
    {
      "name": "AlphaFold2",
      "description": "Launch AlphaFold2 in its packaged JupyterLab environment.",
      "activate": true,
      "terminal": true,
      "working_dir": "{{ HOME }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/AlphaFold2/launch_jupyter.py",
        "{{ PREFIX }}/AlphaFold2/notebooks/Welcome.ipynb"
      ],
      "platforms": {
        "win": {
          "icon": "BASE_PATH_KEYWORD/AlphaFold2/ColabFold_Marv_Logo.ico",
          "command": [
            "{{ PYTHON }}",
            "{{ PREFIX }}/AlphaFold2/launch_jupyter.py",
            "{{ PREFIX }}/AlphaFold2/notebooks/Welcome.ipynb",
            "&",
            "exit"
          ]
        },
        "linux": {
          "icon": "BASE_PATH_KEYWORD/AlphaFold2/ColabFold_Marv_Logo.png"
        },
        "osx": {
          "icon": "BASE_PATH_KEYWORD/AlphaFold2/ColabFold_Marv_Logo.icns"
        }
      }
    }
  ]
}
